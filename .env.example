# ===========================================
# Blackmount AI Aggregator — Environment Variables
# Скопируй в .env.local и заполни значениями
# Документация: docs/ENV_TEMPLATE.md
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- AI Providers (серверные, НИКОГДА в NEXT_PUBLIC_) ---
OPENROUTER_API_KEY=sk-or-...your-openrouter-key
FAL_API_KEY=...your-fal-key
KIE_API_KEY=...your-kie-key

# --- Платежи ЮKassa ---
YUKASSA_SHOP_ID=123456
YUKASSA_SECRET_KEY=live_...your-secret
YUKASSA_WEBHOOK_SECRET=...your-webhook-secret

# --- OAuth (v1.1, не нужны для MVP) ---
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=

# --- Приложение ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
